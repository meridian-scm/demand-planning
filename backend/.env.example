DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5432/meridian_demand
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- AI narratives ----
AI_ENABLED=true

# Which provider generates the AI insight text: "ollama" (local, needs the
# daemon running) or "groq" (hosted, needs GROQ_API_KEY, no local model).
AI_PROVIDER=ollama

# Used when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Used when AI_PROVIDER=groq — get a key at https://console.groq.com/keys
# and put it in backend/.env (gitignored), never here in the template.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
